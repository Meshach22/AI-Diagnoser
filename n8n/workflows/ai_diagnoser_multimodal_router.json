{
  "name": "AI-Diagnoser: Multimodal Intelligence Triage Workflow",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "triage",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "node-webhook-triage",
      "name": "Webhook: Inbound Asset Triage",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [240, 300]
    },
    {
      "parameters": {
        "rules": {
          "values": [
            {
              "conditions": {
                "options": {
                  "caseSensitive": true,
                  "leftValue": "",
                  "typeValidation": "strict"
                },
                "conditions": [
                  {
                    "leftValue": "={{ $json.type }}",
                    "rightValue": "document",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    }
                  }
                ],
                "combinator": "and"
              },
              "renameOutput": true,
              "outputKey": "document_branch"
            },
            {
              "conditions": {
                "options": {
                  "caseSensitive": true,
                  "leftValue": "",
                  "typeValidation": "strict"
                },
                "conditions": [
                  {
                    "leftValue": "={{ $json.type }}",
                    "rightValue": "vision",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    }
                  }
                ],
                "combinator": "and"
              },
              "renameOutput": true,
              "outputKey": "vision_branch"
            },
            {
              "conditions": {
                "options": {
                  "caseSensitive": true,
                  "leftValue": "",
                  "typeValidation": "strict"
                },
                "conditions": [
                  {
                    "leftValue": "={{ $json.type }}",
                    "rightValue": "data",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    }
                  }
                ],
                "combinator": "and"
              },
              "renameOutput": true,
              "outputKey": "data_branch"
            }
          ]
        }
      },
      "id": "node-switch-service",
      "name": "Switch: Core AI Service Triage",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 3,
      "position": [480, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=http://backend:8000/api/v1/documents/summarize",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"text\": \"{{ $json.content }}\",\n  \"summary_type\": \"executive\",\n  \"provider\": \"Google Gemini\"\n}",
        "options": {}
      },
      "id": "node-call-docs",
      "name": "FastAPI: Documents Pipeline",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [740, 160]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=http://backend:8000/api/v1/vision/analyze",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"image_base64\": \"{{ $json.image_base64 }}\",\n  \"task_type\": \"ocr\",\n  \"provider\": \"Google Gemini\"\n}",
        "options": {}
      },
      "id": "node-call-vision",
      "name": "FastAPI: Vision Pipeline",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [740, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=http://backend:8000/api/v1/data/insights",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"dataset_csv\": \"{{ $json.content }}\",\n  \"provider\": \"Google Gemini\"\n}",
        "options": {}
      },
      "id": "node-call-data",
      "name": "FastAPI: Data Pipeline",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [740, 440]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={\n  \"status\": \"success\",\n  \"result\": \"{{ $json.result }}\",\n  \"provider_used\": \"{{ $json.provider_used }}\",\n  \"latency_ms\": \"{{ $json.latency_ms }}\"\n}",
        "options": {}
      },
      "id": "node-respond-triage",
      "name": "Respond to Webhook",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [1020, 300]
    }
  ],
  "connections": {
    "Webhook: Inbound Asset Triage": {
      "main": [
        [
          {
            "node": "Switch: Core AI Service Triage",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Switch: Core AI Service Triage": {
      "main": [
        [
          {
            "node": "FastAPI: Documents Pipeline",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "FastAPI: Vision Pipeline",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "FastAPI: Data Pipeline",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "FastAPI: Documents Pipeline": {
      "main": [
        [
          {
            "node": "Respond to Webhook",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "FastAPI: Vision Pipeline": {
      "main": [
        [
          {
            "node": "Respond to Webhook",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "FastAPI: Data Pipeline": {
      "main": [
        [
          {
            "node": "Respond to Webhook",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  }
}
