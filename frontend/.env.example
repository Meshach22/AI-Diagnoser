# AI-Diagnoser Frontend - Environment Configuration
# Copy this file to .env.local for local overrides. Do NOT commit .env.local to version control.

# Public HTTPS URL of the hosted FastAPI Backend (Used by Next.js serverless rewrites)
BACKEND_URL=http://127.0.0.1:8000

# Optional Direct Client API URL (Uncomment if bypassing Next.js rewrites for >4.5MB uploads)
# NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
