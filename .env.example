# .env.example
# Environment configuration template for AI-Diagnoser.
# Copy to .env for local configuration. NEVER commit .env to version control.

# --- LLM API Credentials ---
GEMINI_API_KEY=""
OPENAI_API_KEY=""
GROQ_API_KEY=""
DEEPSEEK_API_KEY=""

# --- Backend Configuration ---
BACKEND_HOST="0.0.0.0"
BACKEND_PORT="8000"
BACKEND_URL="http://localhost:8000"

# --- n8n Automation Engine Settings ---
N8N_BASE_URL="http://localhost:5678"
N8N_WEBHOOK_URL="http://localhost:5678/webhook/ai-diagnoser"
N8N_EMAIL_WEBHOOK_URL=""
N8N_SLACK_WEBHOOK_URL=""
SLACK_INCOMING_WEBHOOK=""
